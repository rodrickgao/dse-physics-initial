{
  "name": "dse-physics-study-library",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "start": "node server/production.mjs",
    "test:production": "node --test tests/production.test.mjs tests/import-initial.test.mjs",
    "test": "node --test tests/*.test.mjs && node scripts/audit-study.mjs && node scripts/audit-textbook-cards.mjs",
    "dev": "node --env-file-if-exists=.env.local server/dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test:backend": "node --test tests/backend.test.mjs",
    "test:protection": "node --test tests/content-protection.test.mjs && node scripts/audit-content-protection.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "katex": "^0.18.7",
    "lucide-react": "^1.38.0",
    "nodemailer": "^10.0.10",
    "opencc-js": "^1.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
