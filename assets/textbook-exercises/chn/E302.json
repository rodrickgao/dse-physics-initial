></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msup></mrow></mrow></mfrac></mrow></mrow></math></p><p><i>  </i><i>  </i>= <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>Φ cos α</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>4π</mtext></mrow><msup><mrow><mrow><mrow><mtext>(</mtext></mrow><mfrac><mrow><mrow><mrow><mtext>d</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>cos α</mtext></mrow></mrow></mrow></mfrac><mrow><mtext>)</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msup></mrow></mrow></mfrac></mrow></math></p><p>    = <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>Φ </mtext></mrow><msup><mrow><mrow><mrow><mtext>cos</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>3</mtext></mrow></mrow></mrow></msup><mrow><mtext> α</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>4π</mtext></mrow><msup><mrow><mrow><mrow><mtext>d</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msup></mrow></mrow></mfrac></mrow></math></p><p>∴ E ∝ cos³α</p><p><i>  </i>∴  <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><msub><mrow><mrow><mrow><mtext>E</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>Y</mtext></mrow></mrow></mrow></msub></mrow></mrow><mrow><mrow><msub><mrow><mrow><mrow><mtext>E</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>X</mtext></mrow></mrow></mrow></msub></mrow></mrow></mfrac></mrow></math>  = <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><msup><mrow><mrow><mrow><mtext>cos</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>3</mtext></mrow></mrow></mrow></msup><msub><mrow><mrow><mrow><mtext>α</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>Y</mtext></mrow></mrow></mrow></msub></mrow></mrow><mrow><mrow><msup><mrow><mrow><mrow><mtext>cos</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>3</mtext></mrow></mrow></mrow></msup><msub><mrow><mrow><mrow><mtext>α</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>X</mtext></mrow></mrow></mrow></msub></mrow></mrow></mfrac></mrow></math></p><p>    <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>2E</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>E</mtext></mrow></mrow></mrow></mfrac></mrow></math>  = <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><msup><mrow><mrow><mrow><mtext>cos</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>3</mtext></mrow></mrow></mrow></msup><mrow><mtext>(90° − θ)</mtext></mrow></mrow></mrow><mrow><mrow><msup><mrow><mrow><mrow><mtext>cos</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>3</mtext></mrow></mrow></mrow></msup><mrow><mtext>(90° − 40°)</mtext></mrow></mrow></mrow></mfrac></mrow></math></p><p>    cos (90° – <i>θ</i>)  = <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mroot><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>3</mtext></mrow></mrow></mrow></mroot></mrow></math>cos 50°</p><p>    <i>θ</i>  = 54.1°</p>","kind":"multiple-choice","source":{"name":"E302 複習 2 照明.docx","sha256":"f641cfaa7a31522117a94950c3a1c9d27fa1fb47fe1af65e47a37cbc3eca8b11","block":98},"id":"tb-E302-10","chapter":"E302"},"tb-E302-11":{"number":"11","question":"<p><b>光通量是</b><i><b>15 lm</b></i><i><b> </b></i><b>的電筒發射平行光束。面積</b><b>為</b><i><b>25 cm</b></i><i><b><sup>2</sup></b></i><i><b> </b></i><b>的平面</b><i><b>X</b></i><i><b> </b></i><b>阻擋了光束，平面上受</b><b>照射範圍呈圓形，直徑是</b><i><b>6 cm</b></i><b>（圖</b><i><b>d</b></i><b>）。如果</b><b>移走平面</b><i><b>X</b></i><b>，改放另一個面積為</b><i><b>2 cm</b></i><i><b><sup>2</sup></b></i><i><b> </b></i><b>的平</b><b>面</b><i><b>Y</b></i><b>，就只會阻擋部分光束（圖</b><i><b>e</b></i><b>），平面</b><i><b>Y</b></i><b>上</b><i><b>P</b></i><i><b> </b></i><b>點的照明度是多少？</b></p><p class=\"study-figure\"><img src=\"assets/textbook-exercises/media/9f28aba3ca846f895d90d4b6.png\" alt=\"\" style=\"width:309.5px\"/></p><p class=\"study-figure\"><img src=\"assets/textbook-exercises/media/ef791693ea67bf1aa14e9c68.png\" alt=\"\" style=\"width:305.1px\"/></p><p><i><b> </b></i><i><b>A 119 lx</b></i></p><p><i><b> </b></i><i><b>B 5310 lx</b></i></p><p><i><b> </b></i><i><b>C 6000 lx</b></i></p><p>D　75 000 lx</p>","answer":"<p>B</p>","reasoning":"<p>照明度 = <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>Φ</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>A</mtext></mrow></mrow></mrow></mfrac></mrow></math></p><p><b>  </b><b>  </b><b>  </b>= <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>15</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>π × </mtext></mrow><msup><mrow><mrow><mrow><mtext>(0.03)</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msup></mrow></mrow></mfrac></mrow></math></p><p>      = 5310 lx</p>","kind":"multiple-choice","source":{"name":"E302 複習 2 照明.docx","sha256":"f641cfaa7a31522117a94950c3a1c9d27fa1fb47fe1af65e47a37cbc3eca8b11","block":118},"id":"tb-E302-11","chapter":"E302"},"tb-E302-15":{"number":"15","question":"<p><b>天娜想買一盞燈。售貨員告訴她，</b><i><b>8 W</b></i><i><b> </b></i><b>的</b><i><b>LED</b></i><i><b> </b></i><b>燈看起來和</b><i><b>40 W</b></i><i><b> </b></i><b>的白熾燈一樣光亮</b><b>（圖</b><i><b>j</b></i><i><b>）。</b></i><i><b>LED</b></i><i><b> </b></i><b>燈的光視效能是</b><i><b>60 lm W</b></i><i><b><sup>–1</sup></b></i><i><b>。</b></i></p><p class=\"study-figure\"><img src=\"assets/textbook-exercises/media/80b763eef4826d4da1e3131c.png\" alt=\"\" style=\"width:319.7px\"/></p><p><i><b> </b></i><i><b>(a) </b></i><b>該</b><i><b>LED</b></i><i><b> </b></i><b>燈的光通量是多少？</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(b) </b></i><b>該白熾燈的光視效能是多少？</b><i><b> </b></i><i><b>（</b></i><i><b>1</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(c) </b></i><b>天娜每天平均開燈</b><i><b>5</b></i><b> 小時。每</b><i><b>kW h</b></i><b> 的電</b><b>費是</b><i><b>$1.1</b></i><b>。如果她選用該</b><i><b>LED</b></i><b> 燈，每年</b><b>可節省多少電費？取</b><i><b>1</b></i><b> 年</b><i><b> = 365</b></i><b>天。</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(d) </b></i><b>除了更具能源效益之外，舉出</b><i><b>LED</b></i><i><b> </b></i><b>燈與</b><b>白熾燈相比的另一項優勝之處。</b><i><b> </b></i><i><b>（</b></i><i><b>1</b></i><b> 分）</b></p>","answer":"<p>(a) 光通量</p><p>= 光視效能 × 輸入功率  1M</p><p>    = 60 × 8</p><p>    = 480 lm  1A</p><p>(b) 光視效能 = <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>光通量</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>輸入功率</mtext></mrow></mrow></mrow></mfrac></mrow></math></p><p><b>  </b><b>  </b><b>  </b>= <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>480</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>40</mtext></mrow></mrow></mrow></mfrac></mrow></math></p><p>      = 12 lm W<sup>−</sup><sup>1</sup>  1A</p><p>(c) 電費的差額</p><p>    = 1.1 ×<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mrow><mfrac><mrow><mrow><mrow><mtext>40−8</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>1000</mtext></mrow></mrow></mrow></mfrac></mrow></mrow></math>× 5 × 365</p><p>    = $64.2  1A</p><p>(d) 它的壽命較長。  1A</p><p>（或其他合理答案。）</p><p>編校註：(c) 題面標示 2 分，中英文官方題解只標示一個一分答案評分點；本版保留原有標記。</p>","reasoning":"","kind":"structured","source":{"name":"E302 複習 2 照明.docx","sha256":"f641cfaa7a31522117a94950c3a1c9d27fa1fb47fe1af65e47a37cbc3eca8b11","block":130},"id":"tb-E302-15","chapter":"E302"},"tb-E302-16":{"number":"16","question":"<p><b>地球和火星都是太陽系中的行星，火星與</b><b>太陽的距離約為地球與太陽的距離的</b><i><b>1.5</b></i><b> 倍</b><i><b> </b></i><b>（圖</b><i><b>k</b></i><b>）。在某一瞬間，地球上某城市受陽光</b><b>垂直照射，照明度是</b><i><b>1.3 </b></i><i><b>×</b></i><i><b> 10</b></i><i><b><sup>5</sup></b></i><i><b> lx</b></i><b>。假設太陽</b><b>光照向行星時不受任何阻擋。</b></p><p class=\"study-figure\"><img src=\"assets/textbook-exercises/media/0d9fc208e31c36922c59db8d.png\" alt=\"\" style=\"width:319.7px\"/></p><p><i><b> </b></i><i><b>(a) </b></i><b>陽光垂直照射在火星上的某一點，估算該</b><b>點的照明度。</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(b) </b></i><b>地球距離太陽</b><i><b>1.5 </b></i><i><b>×</b></i><i><b> 10</b></i><i><b><sup>11</sup></b></i><i><b> m</b></i><b>。估算太陽的</b><b>光通量。</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p>","answer":"<p>(a) 照明度 = <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>Φ</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>4π</mtext></mrow><msup><mrow><mrow><mrow><mtext>r</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msup></mrow></mrow></mfrac></mrow></math> ∝ <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>1</mtext></mrow></mrow></mrow><mrow><mrow><msup><mrow><mrow><mrow><mtext>r</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msup></mrow></mrow></mfrac></mrow></math>（Φ 不變）</p><p>    ∴ <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><msub><mrow><mrow><mrow><mtext>E</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msub></mrow></mrow><mrow><mrow><msub><mrow><mrow><mrow><mtext>E</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>1</mtext></mrow></mrow></mrow></msub></mrow></mrow></mfrac></mrow></math>=<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>1</mtext></mrow></mrow></mrow><mrow><mrow><msup><mrow><mrow><msub><mrow><mrow><mrow><mtext>r</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msub></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msup></mrow></mrow></mfrac></mrow></math>÷<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>1</mtext></mrow></mrow></mrow><mrow><mrow><msup><mrow><mrow><msub><mrow><mrow><mrow><mtext>r</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>1</mtext></mrow></mrow></mrow></msub></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msup></mrow></mrow></mfrac></mrow></math></p><p>  <i>E</i><sub>2</sub>  =<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><msup><mrow><mrow><msub><mrow><mrow><mrow><mtext>r</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>1</mtext></mrow></mrow></mrow></msub></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msup></mrow></mrow><mrow><mrow><msup><mrow><mrow><msub><mrow><mrow><mrow><mtext>r</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msub></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msup></mrow></mrow></mfrac></mrow></math>× <i>E</i><sub>1</sub></p><p>    =<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><msup><mrow><mrow><mrow><mtext>r</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msup></mrow></mrow><mrow><mrow><mrow><mtext>(1.5r</mtext></mrow><msup><mrow><mrow><mrow><mtext>)</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msup></mrow></mrow></mfrac></mrow></math> × 1.3 × 10<sup>5</sup></p><p>    = 5.78 × 10<sup>4</sup> lx</p><p>  <b>(b)</b>  Φ = <i>AE</i></p><p>    = 4π<i>r</i><sup>2</sup> × <i>E</i></p><p><i>  </i><i>  </i>= 4π × (1.5 × 10<sup>11</sup>)<sup>2</sup> × 1.3 × 10<sup>5</sup></p><p>    = 3.68 × 10<sup>28</sup> lm</p><p>編校註：本題兩小題各標示 2 分，但中英文官方題解均未逐步標示評分點；本版保留完整計算，不自行補造官方評分標記。</p>","reasoning":"","kind":"structured","source":{"name":"E302 複習 2 照明.docx","sha256":"f641cfaa7a31522117a94950c3a1c9d27fa1fb47fe1af65e47a37cbc3eca8b11","block":151},"id":"tb-E302-16","chapter":"E302"},"tb-E302-17":{"number":"17","question":"<p><i><b>(a) </b></i><b>試以電子躍遷說明白熾燈的運作原理。</b><i><b> </b></i><i><b>（</b></i><i><b>3</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(b) </b></i><b>據此，解釋為甚麼白熾燈的光視效能很</b><b>低。</b><i><b> </b></i><i><b>（</b></i><i><b>1</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(c) </b></i><b>寫出白熾燈與緊湊型熒光燈相比的一個優</b><b>點和一個缺點。</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p>","answer":"<p>(a) 燈絲連接至電源時，電流把燈絲加熱，  1A</p><p>令電子受激至不同的較高能級。  1A</p><p>當電子跌至不同的較低能級，燈絲便放出各種頻率不同的電磁波。  1A</p><p>(b) 燈絲放出的電磁波中，只有小部分是可見光。  1A</p><p>(c) 優點：白熾燈不含水銀。  1A</p><p>缺點：白熾燈的壽命較短。  1A</p><p>（或其他合理答案。）</p>","reasoning":"","kind":"structured","source":{"name":"E302 複習 2 照明.docx","sha256":"f641cfaa7a31522117a94950c3a1c9d27fa1fb47fe1af65e47a37cbc3eca8b11","block":167},"id":"tb-E302-17","chapter":"E302"},"tb-E302-18":{"number":"18","question":"<p><i><b>X</b></i><i><b> </b></i><b>是平面上的一點。點光源的輸入功率是</b><i><b> </b></i><i><b>60 W</b></i><b>，與</b><i><b>X</b></i><i><b> </b></i><b>點的距離是</b><i><b>2 m</b></i><b>（圖</b><i><b>l</b></i><i><b>）。</b></i><i><b>X</b></i><i><b> </b></i><b>點的</b><b>照明度是</b><i><b>50 lx</b></i><i><b>。</b></i></p><p class=\"study-figure\"><img src=\"assets/textbook-exercises/media/add392689c278bafbc943059.png\" alt=\"\" style=\"width:174.5px\"/></p><p><i><b> </b></i><i><b>(a) </b></i><b>照明度是什麼意思？</b><i><b> </b></i><i><b>（</b></i><i><b>1</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(b) </b></i><b>求點光源的光通量。</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(c) </b></i><b>求點光源的光視效能。</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p>","answer":"<p>(a) 照明度是每單位面積所接收的光通量。  1A</p><p>(b) 根據 E = <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>Φ cos θ</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>4π</mtext></mrow><msup><mrow><mrow><mrow><mtext>r</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msup></mrow></mrow></mfrac></mrow></math>，  1M</p><p>光通量 = <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>4π</mtext></mrow><msup><mrow><mrow><mrow><mtext>r</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msup><mrow><mtext>E</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>cos θ</mtext></mrow></mrow></mrow></mfrac></mrow></math></p><p>      = <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>4π × </mtext></mrow><msup><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msup><mrow><mtext> × 50</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>cos(90° − 60°)</mtext></mrow></mrow></mrow></mfrac></mrow></math></p><p>      = 2902 lm</p><p>      ≈ 2900 lm  1A</p><p>(c) 光視效能 = <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>光通量</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>輸入功率</mtext></mrow></mrow></mrow></mfrac></mrow></math>  1M</p><p>      = <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>2902</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>60</mtext></mrow></mrow></mrow></mfrac></mrow></math></p><p>      = 48.4 lm W<sup>−</sup><sup>1</sup>  1A</p>","reasoning":"","kind":"structured","source":{"name":"E302 複習 2 照明.docx","sha256":"f641cfaa7a31522117a94950c3a1c9d27fa1fb47fe1af65e47a37cbc3eca8b11","block":179},"id":"tb-E302-18","chapter":"E302"},"tb-E302-19":{"number":"19","question":"<p><b>圖</b><i><b>m</b></i><i><b> </b></i><b>顯示一盞</b><i><b>20-W</b></i><i><b> </b></i><b>緊湊型熒光燈的能源</b><b>標籤。</b></p><p class=\"study-figure\"><img src=\"assets/textbook-exercises/media/c11f26c299c6033835dcbc36.png\" alt=\"\" style=\"width:202.4px\"/></p><p><i><b> </b></i><i><b>(a) </b></i><b>這盞燈的光通量是多少？</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(b) </b></i><b>寶妮將這盞緊湊型熒光燈安裝在房間的天</b><b>花板（圖</b><i><b>n</b></i><b>）。假設燈是點光源。</b><i><b>P</b></i><i><b> </b></i><b>是桌</b><b>上的一點。</b></p><p class=\"study-figure\"><img src=\"assets/textbook-exercises/media/605a25b54e390f5f0c033a5f.png\" alt=\"\" style=\"width:288.9px\"/></p><p><i><b> </b></i><i><b> </b></i><i><b>(i) </b></i><b>估算</b><i><b>P</b></i><i><b> </b></i><b>點的照明度。</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p><p><i><b> </b></i><i><b> </b></i><i><b>(ii) </b></i><i><b>P</b></i><i><b> </b></i><b>點的實際照明度大於、等於還是小</b><b>於</b><i><b>(i)</b></i><i><b> </b></i><b>的答案？試簡單解釋。</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(c) </b></i><b>緊湊型熒光燈的玻璃管上有特殊塗層。試</b><b>說明這塗層的作用。</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(d) </b></i><b>白熾燈要消耗較高功率，才能有相同亮</b><b>度。試解釋原因。</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p>","answer":"<p>(a) 光通量 = 70 × 20  1M</p><p>      = 1400 lm  1A</p><p>(b) (i) P 點的照明度</p><p>      = <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>Φ cos θ</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>4π</mtext></mrow><msup><mrow><mrow><mrow><mtext>r</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msup></mrow></mrow></mfrac></mrow></math>  1M</p><p>      = <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>1400 cos(90° − 50°)</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>4π × </mtext></mrow><msup><mrow><mrow><mrow><mtext>1.8</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msup></mrow></mrow></mfrac></mrow></math></p><p>      = 26.3 lx  1A</p><p>(ii) 實際的照明度較高，  1A</p><p>因為牆壁和天花板會把光反射到桌上。  1A</p><p>(c) 塗層吸收紫外輻射，  1A</p><p>然後放出可見光。  1A</p><p>(d) 白熾燈放出的電磁波以紅外輻射為主，  1A</p><p>紅外輻射不可用於照明。  1A</p><p>編校註：(b)(i) 應使用 (a) 算得的光通量 1400 lm。原題解誤用 1750 lm，得到 32.9 lx；已更正為 26.3 lx。</p>","reasoning":"","kind":"structured","source":{"name":"E302 複習 2 照明.docx","sha256":"f641cfaa7a31522117a94950c3a1c9d27fa1fb47fe1af65e47a37cbc3eca8b11","block":195},"id":"tb-E302-19","chapter":"E302"},"tb-E302-20":{"number":"20","question":"<p><b>明希打算購買一盞光通量大於</b><i><b>1100 lm</b></i><i><b> </b></i><b>的</b><b>燈。他在商店見到以下幾款燈（表</b><i><b>a</b></i><i><b>）。</b></i></p><div class=\"study-table-wrap\"><table><tbody><tr><td><p><b>燈</b></p></td><td><p><b>額定功率</b></p></td><td><p><b>光視效能</b></p></td><td><p><b>價格</b></p></td></tr><tr><td><p><b>P</b></p></td><td><p><b>15 W</b></p></td><td><p><b>90 lm W⁻¹</b></p></td><td><p><b>$50</b></p></td></tr><tr><td><p><b>Q</b></p></td><td><p><b>60 W</b></p></td><td><p><b>17 lm W⁻¹</b></p></td><td><p><b>$30</b></p></td></tr><tr><td><p><b>R</b></p></td><td><p><b>100 W</b></p></td><td><p><b>12 lm W⁻¹</b></p></td><td><p><b>$10</b></p></td></tr></tbody></table></div><p><i><b> </b></i><i><b>(a) </b></i><b>證明燈</b><i><b>Q</b></i><i><b> </b></i><b>不符合明希的要求。</b><i><b> </b></i><i><b>（</b></i><i><b>1</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(b) </b></i><b>現考慮燈</b><i><b>P</b></i><i><b> </b></i><b>和</b><i><b>R</b></i><b>。每</b><i><b>kW h</b></i><i><b> </b></i><b>的電費是</b><i><b>$1.1</b></i><b>。如每天開燈</b><i><b>8</b></i><b> 小時，要多少天電費</b><b>差額才足以抵消價格差額？</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(c) </b></i><b>在</b><i><b>P</b></i><i><b> </b></i><b>和</b><i><b>R</b></i><i><b> </b></i><b>兩盞燈中，一盞是緊湊型熒光</b><b>燈，另一盞是白熾燈。</b></p><p><i><b> </b></i><i><b> </b></i><i><b>(i) </b></i><b>描述緊湊型熒光燈怎樣產生可見光。</b><i><b> </b></i><i><b>（</b></i><i><b>3</b></i><b> 分）</b></p><p><i><b> </b></i><i><b> </b></i><i><b>(ii) </b></i><b>解釋</b><i><b>P</b></i><i><b> </b></i><b>和</b><i><b>R</b></i><i><b> </b></i><b>哪一盞燈是緊湊型熒光</b><b>燈。</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(d) </b></i><b>明希購買了緊湊型熒光燈，並安裝在房間</b><b>裏（圖</b><i><b>o</b></i><b>）。假設該燈是點光源。</b></p><p class=\"study-figure\"><img src=\"assets/textbook-exercises/media/a88c823b17b5de97273c8e12.png\" alt=\"\" style=\"width:296.3px\"/></p><p><i><b> </b></i><i><b> </b></i><i><b>X</b></i><i><b> </b></i><b>是床墊表面的一點。連接</b><i><b>X</b></i><i><b> </b></i><b>點和燈的</b><b>線與</b><i><b>X</b></i><i><b> </b></i><b>點的法線形成</b><i><b>30°</b></i><b>的夾角。求</b><i><b>X</b></i><b>點的照明度。</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p>","answer":"<p>(a) 燈 Q 的光通量</p><p>= 光視效能 × 輸入功率</p><p>    = 17 × 60</p><p>    = 1020 lm (&lt; 1100 lm)  1A</p><p>(b) 每日電費的差額</p><p>    = 1.1 ×<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>100 − 15</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>1000</mtext></mrow></mrow></mrow></mfrac></mrow></math>× 8 </p><p>    = $0.748</p><p>    ∴ 50 − 10 = 0.748<i>t</i>  1M</p><p>t = 53.5 日</p><p>需要 53.5 日。  1A</p><p>(c) (i) 施加高電壓於燈兩端的電極之間，電流令玻璃管升温，並使管內的水銀汽化。  1A</p><p>水銀原子內發生電子躍遷，主要放出紫外輻射。  1A</p><p>磷光質塗層吸收紫外輻射後，放出可見光。  1A</p><p>(ii) 燈 P 是緊湊型熒光燈，  1A</p><p>因為它的光視效能較高。  1A</p><p>(d) 照明度 = <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>Φ cos θ</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>4π</mtext></mrow><msup><mrow><mrow><mrow><mtext>r</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msup></mrow></mrow></mfrac></mrow></math>  1M</p><p>      = <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>15 </mtext></mrow><mrow><mtext>×</mtext></mrow><mrow><mtext> 90</mtext></mrow><mrow><mrow><mrow><mtext>cos</mtext></mrow></mrow><mrow><mrow><mtext>30</mtext></mrow><mrow><mtext>°</mtext></mrow></mrow></mrow></mrow></mrow><mrow><mrow><mrow><mtext>4π </mtext></mrow><mrow><mtext>×</mtext></mrow><mrow><mtext> 2.</mtext></mrow><msup><mrow><mrow><mrow><mtext>5</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msup></mrow></mrow></mfrac></mrow></math></p><p>      = 14.9 lx  1A</p>","reasoning":"","kind":"structured","source":{"name":"E302 複習 2 照明.docx","sha256":"f641cfaa7a31522117a94950c3a1c9d27fa1fb47fe1af65e47a37cbc3eca8b11","block":219},"id":"tb-E302-20","chapter":"E302"},"tb-E302-21":{"number":"21","question":"<p><b>學生做實驗，估算緊湊型熒光燈的光通量</b><i><b> </b></i><b>（圖</b><i><b>p</b></i><i><b>）。</b></i></p><p class=\"study-figure\"><img src=\"assets/textbook-exercises/media/b287fa9bda280591613704c7.png\" alt=\"\" style=\"width:328.5px\"/></p><p><i><b> </b></i><i><b> </b></i><b>學生改變測光儀和緊湊型熒光燈之間的距離</b><i><b>d</b></i><b>，並把相應的照明度</b><i><b>E</b></i><i><b> </b></i><b>記錄下來（表</b><i><b>b</b></i><i><b>）。</b></i></p><div class=\"study-table-wrap\"><table><tbody><tr><td><p><b>d / m</b></p></td><td><p><b>1.0</b></p></td><td><p><b>1.1</b></p></td><td><p><b>1.2</b></p></td><td><p><b>1.3</b></p></td><td><p><b>1.4</b></p></td><td><p><b>1.5</b></p></td></tr><tr><td><p><b>E / lx</b></p></td><td><p><b>119</b></p></td><td><p><b>102</b></p></td><td><p><b>81</b></p></td><td><p><b>73</b></p></td><td><p><b>60</b></p></td><td><p><b>55</b></p></td></tr></tbody></table></div><p><i><b> </b></i><i><b>(a) </b></i><b>利用</b><i><b>E</b></i><i><b> </b></i><b>與另一合適的量，標繪一幅直線</b><b>圖，以展示平方反比定律。</b><i><b> </b></i><i><b>（</b></i><i><b>4</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(b) </b></i><b>根據</b><i><b>(a)</b></i><i><b> </b></i><b>的線圖，估算緊湊型熒光燈的光</b><b>通量。</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(c) </b></i><b>試建議兩個方法來提高這個實驗的準確</b><b>度。</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p>","answer":"<p><b></b><b>  (a)</b>  </p><div class=\"study-table-wrap\"><table><tbody><tr><td><p><i><b>d</b></i><b> / m</b></p></td><td><p>1.0</p></td><td><p>1.1</p></td><td><p>1.2</p></td><td><p>1.3</p></td><td><p>1.4</p></td><td><p>1.5</p></td></tr><tr><td><p><i><b>E</b></i><b> / lx</b></p></td><td><p>119</p></td><td><p>102</p></td><td><p>81</p></td><td><p>73</p></td><td><p>60</p></td><td><p>55</p></td></tr><tr><td><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>1</mtext></mrow></mrow></mrow><mrow><mrow><msup><mrow><mrow><mrow><mtext>d</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></msup></mrow></mrow></mfrac></mrow></math><b>/ m</b><b><sup>−</sup></b><b><sup>2</sup></b></p></td><td><p>1.0</p></td><td><p>0.83</p></td><td><p>0.69</p></td><td><p>0.59</p></td><td><p>0.51</p></