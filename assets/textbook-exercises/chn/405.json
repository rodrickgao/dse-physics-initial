>0</mtext></mrow></mrow></mrow></msub><msub><mrow><mrow><mrow><mtext>I</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>X</mtext></mrow></mrow></mrow></msub></mrow></mrow><mrow><mrow><mrow><mtext>2π</mtext></mrow><msub><mrow><mrow><mrow><mtext>r</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>QX</mtext></mrow></mrow></mrow></msub></mrow></mrow></mfrac></mrow></mrow></math>–<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mrow><mfrac><mrow><mrow><msub><mrow><mrow><mrow><mtext>μ</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>0</mtext></mrow></mrow></mrow></msub><msub><mrow><mrow><mrow><mtext>I</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>Y</mtext></mrow></mrow></mrow></msub></mrow></mrow><mrow><mrow><mrow><mtext>2π</mtext></mrow><msub><mrow><mrow><mrow><mtext>r</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>QY</mtext></mrow></mrow></mrow></msub></mrow></mrow></mfrac></mrow></mrow></math></p><p>      =<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>(4π × </mtext></mrow><msup><mrow><mrow><mrow><mtext>10</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>−7</mtext></mrow></mrow></mrow></msup><mrow><mtext>)(2.5)</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>2π(0.05)</mtext></mrow></mrow></mrow></mfrac></mrow></math>–<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>(4π × </mtext></mrow><msup><mrow><mrow><mrow><mtext>10</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>−7</mtext></mrow></mrow></mrow></msup><mrow><mtext>)(2.5)</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>2π(0.15)</mtext></mrow></mrow></mrow></mfrac></mrow></math><br/>    1M</p><p>= 6.67 × 10⁻⁶ T（向下）  1A</p>","reasoning":"","kind":"structured","source":{"name":"405 複習 5 磁場.docx","sha256":"575bf52700c0e0af27eaea271878b0c4952bd6a12db63a2c74708df1c08911ba","block":148},"id":"tb-405-14","chapter":"405"},"tb-405-15":{"number":"15","question":"<p><b>現給你一個軟彈簧、一個安培計、一個變阻</b><b>器、一個磁場感應器和一把米尺。</b></p><p><i><b> </b></i><i><b>(a) </b></i><b>描述實驗步驟，以探究長螺線管內磁場的</b><b>強度與螺線管每單位長度線圈匝數的關</b><b>係。寫出實驗的預期結果。</b><i><b> </b></i><i><b>（</b></i><i><b>5</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(b) </b></i><b>寫出所需的預防措施。</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p>","answer":"<p>(a) 把變阻器、安培計和軟彈簧串聯連接至電源。  1A</p><p>把軟彈簧拉至某一長度，用米尺量度長度 l，並計算每單位長度的線圈匝數 n。  1A</p><p>接通電源，調整變阻器的電阻，使電路中的電流達至某一數值。用磁場感應器量度軟彈簧中心的磁場強度 B。  1A</p><p>把軟彈簧拉至不同長度並重複實驗。每次均須調整變阻器，使電路中的電流保持相同。  1A</p><p>繪畫 B–n 線圖，預期得到通過原點的直線。  1A</p><p>(b) 開始時，應把變阻器的電阻調至最大。  1A</p><p>完成量度後，應立即關掉電源。  1A</p>","reasoning":"","kind":"structured","source":{"name":"405 複習 5 磁場.docx","sha256":"575bf52700c0e0af27eaea271878b0c4952bd6a12db63a2c74708df1c08911ba","block":167},"id":"tb-405-15","chapter":"405"},"tb-405-16":{"number":"16","question":"<p><b>家俊設計了一個電磁門鎖（圖</b><i><b>n</b></i><b>），它包含一</b><b>片安裝在門上的鐵塊。開關</b><i><b>S</b></i><i><b> </b></i><b>斷開時，門會</b><b>因電磁鐵</b><i><b>A</b></i><i><b> </b></i><b>的吸力而鎖上。電磁鐵</b><i><b>A</b></i><i><b> </b></i><b>和</b><i><b>B</b></i><b>的線圈都繞在軟鐵心上。開關</b><i><b>S</b></i><i><b> </b></i><b>閉合時，</b><i><b>P</b></i><b>點和</b><i><b>Q</b></i><i><b> </b></i><b>點互相接觸，家俊認為這時候門就可</b><b>以打開。</b></p><p class=\"study-figure\"><img src=\"assets/textbook-exercises/media/f5037901b160b94ca23c80a2.png\" alt=\"\" style=\"width:322.7px\"/></p><p><i><b> </b></i><i><b>(a) (i) </b></i><b>家俊發現即使</b><i><b>S</b></i><i><b> </b></i><b>閉合，門還是鎖上</b><b>了。他的電路有甚麼問題？試藉着說</b><b>明電路中各支路的電流變化來解釋。</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p><p><i><b> </b></i><i><b> </b></i><i><b>(ii) </b></i><b>他決定把</b><i><b>R</b></i><i><b><sub>1</sub></b></i><b> 移到電路中的其他位置</b><b>來以修正問題。</b><i><b>R</b></i><i><b><sub>1</sub></b></i><b> 應放在哪個位置？</b><b>試解釋這項改動為甚麼有效。</b><i><b> </b></i><i><b>（</b></i><i><b>3</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(b) </b></i><b>電磁鐵</b><i><b>B</b></i><i><b> </b></i><b>的線圈長</b><i><b>2 cm</b></i><b>，有</b><i><b>150</b></i><b> 匝，電</b><b>阻為</b><i><b>2 </b></i><i><b>Ω</b></i><b>，連接</b><i><b>1.5 V</b></i><i><b> </b></i><b>電池。假設電磁鐵</b><b>的芯核心已移除。</b></p><p><i><b> </b></i><i><b> </b></i><i><b>(i) </b></i><b>試估算開關閉合時，在線圈中心磁場</b><b>的強度。</b><i><b> </b></i><i><b>（</b></i><i><b>3</b></i><b> 分）</b></p><p><i><b> </b></i><i><b> </b></i><i><b>(ii) </b></i><b>在</b><i><b>(b)(i) </b></i><b>做了甚麼假設？</b><i><b> </b></i><i><b>（</b></i><i><b>1</b></i><b> 分）</b></p><p><i><b> </b></i><i><b> </b></i><i><b>(iii) </b></i><b>軟鐵心在電磁鐵中有甚麼作用？</b><i><b> </b></i><i><b> </b></i><i><b>（</b></i><i><b>1</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(c) </b></i><b>舉出增強電磁鐵</b><i><b>A</b></i><i><b> </b></i><b>的兩個方法。</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p>","answer":"<p>(a) (i) 電磁鐵 A 與包含 R₁ 的支路並聯接至電池組。  1A</p><p>S 閉合後，P、Q 接通，R₁ 支路由沒有電流變為有電流；但電磁鐵 A 兩端的電壓不變，流過 A 的電流也不變，因此 A 繼續吸引門上的鐵塊。  1A</p><p>(ii) R₁ 應與電池組串聯。  1A</p><p>當 P、Q 接觸時，電磁鐵 A 被短路。  1A</p><p>流過 A 的電流變成零，吸力消失，門便可打開。  1A</p><p>(b) (i) 流過電磁鐵 B 的電流 I</p><p><i>  </i><i>  </i><i>  </i>=<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mrow><mfrac><mrow><mrow><mrow><mtext>V</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>R</mtext></mrow></mrow></mrow></mfrac></mrow></mrow></math>=<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mrow><mfrac><mrow><mrow><mrow><mtext>1.5</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>2</mtext></mrow></mrow></mrow></mfrac></mrow></mrow></math>= 0.75 A  1M</p><p>磁場強度</p><p>      =<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mrow><mfrac><mrow><mrow><msub><mrow><mrow><mrow><mtext>μ</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>0</mtext></mrow></mrow></mrow></msub><mrow><mtext>NI</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>l</mtext></mrow></mrow></mrow></mfrac></mrow></mrow></math></p><p>      =<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><mrow><mtext>(4π × </mtext></mrow><msup><mrow><mrow><mrow><mtext>10</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>−7</mtext></mrow></mrow></mrow></msup><mrow><mtext>)(150)(0.75)</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>0.02</mtext></mrow></mrow></mrow></mfrac></mrow></math>  1M</p><p>      = 7.07 × 10<sup>–3</sup> T  1A</p><p>      = 7.07 mT</p><p>(ii) 假設線圈的半徑遠小於其長度。  1A</p><p>(iii) 增強磁場。  1A</p><p>(c) 以電阻較小的電阻器取代 R₂。  1A</p><p>增加電磁鐵 A 的線圈匝數。  1A</p><p>（或其他合理答案。）</p>","reasoning":"","kind":"structured","source":{"name":"405 複習 5 磁場.docx","sha256":"575bf52700c0e0af27eaea271878b0c4952bd6a12db63a2c74708df1c08911ba","block":179},"id":"tb-405-16","chapter":"405"},"tb-405-17":{"number":"17","question":"<p><b>回收廠利用電磁鐵撿起鐵和鋼。家文為回收</b><b>廠設計了以下的電路（圖</b><i><b>o</b></i><i><b>）。</b></i></p><p class=\"study-figure\"><img src=\"assets/textbook-exercises/media/0c41ee40b13e563abfb7cd8e.png\" alt=\"\" style=\"width:291.9px\"/></p><p><i><b> </b></i><i><b> </b></i><i><b> </b></i><b>他預期電磁鐵可以把磁性物體撿出來。</b></p><p><i><b> </b></i><i><b>(a) </b></i><b>這個設計的電磁鐵吸引磁性物料的效率不</b><b>高。試解釋原因，並提出一個改善方法。</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(b) </b></i><b>即使開關斷開，電磁鐵仍保留磁性。試解</b><b>釋原因，並提出一個解決辦法。</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(c) </b></i><b>舉出增強電磁鐵的兩個方法。</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p>","answer":"<p>(a) 電磁鐵吸力最強的磁極，沒有面向待分揀的物料。  1A</p><p>可用以下任何一個方法改善設計：  1A</p><p>把電磁鐵轉動 90°，使線圈一端面向待分揀的物料。</p><p>改用 U 形磁心，使兩端均面向待分揀的物料。</p><p>(b) 移除外加磁場後，鋼仍保留部分磁性。  1A</p><p>可用軟鐵心取代鋼心來解決。  1A</p><p>(c) 增加電源的電動勢。  1A</p><p>增加線圈每單位長度的匝數。  1A</p>","reasoning":"","kind":"structured","source":{"name":"405 複習 5 磁場.docx","sha256":"575bf52700c0e0af27eaea271878b0c4952bd6a12db63a2c74708df1c08911ba","block":207},"id":"tb-405-17","chapter":"405"},"tb-405-18":{"number":"18","question":"<p><b>假設你參加了一項比賽，要製造一個電磁鐵來</b><b>把萬字夾由一個容器傳送至另一個容器，途中</b><b>不可用手接觸萬字夾。傳送最多萬字夾的參賽</b><b>者便獲勝。圖</b><i><b>p</b></i><b> 顯示三組物料，你可在每組中</b><b>選一個配件來製造電磁鐵。</b></p><p class=\"study-figure\"><img src=\"assets/textbook-exercises/media/1acc7ce7847f9e03e93bdca2.png\" alt=\"\" style=\"width:346.1px\"/></p><p><i><b> </b></i><i><b>(a) </b></i><b>每組的最佳選擇是甚麼？試簡單解釋。</b><i><b> </b></i><i><b>（</b></i><i><b>6</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(b) </b></i><b>試繪畫簡圖來展示你的設計，在圖中加上</b><b>標示。</b><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p>","answer":"<p>(a) 鐵心。  1A</p><p>三種物料中，鐵最容易被磁化。  1A</p><p>長 0.4 m、直徑 2 mm 的銅線。  1A</p><p>三條銅線中，它的電阻最小；接至同一電池時，電流最大，因此產生的磁場最強。  1A</p><p>9 V 電池。  1A</p><p>電壓較高，電流較大，因此磁場較強。  1A</p><div class=\"study-table-wrap\"><table><tbody><tr><td><p>  (b)</p></td><td><p class=\"study-figure\"><img src=\"assets/textbook-exercises/media/0eaa61a3c3b7e8a9afb3ea52.png\" alt=\"\" style=\"width:500.0px\"/></p></td></tr></tbody></table></div><p>圖中文字：wire coil：導線線圈；core：鐵心。</p><p>（導線繞在鐵心上，並連接至電池。）  1A</p><p>（標示正確。）  1A</p>","reasoning":"","kind":"structured","source":{"name":"405 複習 5 磁場.docx","sha256":"575bf52700c0e0af27eaea271878b0c4952bd6a12db63a2c74708df1c08911ba","block":223},"id":"tb-405-18","chapter":"405"},"tb-405-19":{"number":"19","question":"<p><b>圖</b><i><b>q</b></i><i><b> </b></i><b>顯示一種門鈴的構造。棒</b><i><b>PQ</b></i><i><b> </b></i><b>由軟鐵桿</b><b>和塑膠桿首尾相接而成，</b><i><b>P</b></i><i><b> </b></i><b>端套入了彈簧。</b></p><p class=\"study-figure\"><img src=\"assets/textbook-exercises/media/dbfae0e4508ff649d0209d5e.png\" alt=\"\" style=\"width:325.6px\"/></p><p><i><b> </b></i><i><b>(a) </b></i><b>簡單解釋按下和鬆開門鈴按鈕會聽到「叮</b><b>噹」聲響的原因。</b><i><b> </b></i><i><b>（</b></i><i><b>3</b></i><b> 分）</b></p><p><i><b> </b></i><i><b>(b) </b></i><b>解釋在下列情況，門鈴可否如常運作。</b></p><p><i><b> </b></i><i><b> </b></i><i><b>(i) </b></i><b>電池組的兩極對調</b></p><p><i><b> </b></i><i><b> </b></i><i><b>(ii) </b></i><b>用銅桿取代軟鐵桿</b></p><p><i><b> </b></i><i><b> </b></i><i><b>(iii) </b></i><b>線圈由較粗的導線製成</b><i><b> </b></i><i><b>（</b></i><i><b>6</b></i><b> 分）</b></p>","answer":"<p>(a) 按下門鈴按鈕時，電流流過線圈，線圈產生的磁場吸引軟鐵桿。  1A</p><p>軟鐵桿被拉入線圈，Q 端敲擊金屬板 A，發出「叮」聲。  1A</p><p>鬆開門鈴按鈕時，線圈中沒有電流，軟鐵桿不再受吸引。彈簧把桿推出線圈，P 端敲擊金屬板 B，發出「噹」聲。  1A</p><p>(b) (i) 門鈴仍可運作。  1A</p><p>電池組兩極對調會使線圈產生的磁場反向，但軟鐵桿仍被吸入線圈。  1A</p><p>(ii) 門鈴不能運作。  1A</p><p>銅桿不是磁性物料，線圈有電流通過時，銅桿不會被吸入線圈。  1A</p><p>(iii) 門鈴仍可運作。  1A</p><p>用較粗的導線製作線圈，電路的總電阻會減小。</p><p>流過線圈的電流因而增加，使電磁鐵的磁場更強。  1A</p>","reasoning":"","kind":"structured","source":{"name":"405 複習 5 磁場.docx","sha256":"575bf52700c0e0af27eaea271878b0c4952bd6a12db63a2c74708df1c08911ba","block":239},"id":"tb-405-19","chapter":"405"},"tb-405-20":{"number":"20","question":"<p><i><b>A</b></i><i><b> </b></i><b>和</b><i><b>B</b></i><i><b> </b></i><b>是兩條無限長的平行導線，相距</b><i><b>3 cm</b></i><b>，通過兩者的電流分別是</b><i><b>I</b></i><i><b><sub>A</sub></b></i><i><b> </b></i><b>和</b><i><b>I</b></i><i><b><sub>B</sub></b></i><b>，而</b><i><b>I</b></i><i><b><sub>A</sub></b></i><i><b> </b></i><b>向上流動（圖</b><i><b>r</b></i><i><b>）。</b></i><i><b>P</b></i><i><b> </b></i><b>點與</b><i><b>A</b></i><i><b> </b></i><b>之間的距離是</b><i><b>r</b></i><b>，兩條導線和</b><i><b>P</b></i><i><b> </b></i><b>點都處於同一平面。</b></p><p class=\"study-figure\"><img src=\"assets/textbook-exercises/media/1b1d9102701336e913983a6f.png\" alt=\"\" style=\"width:163.8px\"/></p><p><i><b> </b></i><i><b>(a) </b></i><b>在</b><i><b>P</b></i><i><b> </b></i><b>點的磁場是零。</b></p><p><i><b> </b></i><i><b> </b></i><i><b>(i) </b></i><b>判斷</b><i><b>I</b></i><i><b><sub>B</sub></b></i><i><b> </b></i><b>的方向。</b><i><b> </b></i><i><b>（</b></i><i><b>1</b></i><b> 分）</b></p><p>(ii) 求電流比 <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mfrac><mrow><mrow><msub><mrow><mrow><mrow><mtext>I</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>A</mtext></mrow></mrow></mrow></msub></mrow></mrow><mrow><mrow><msub><mrow><mrow><mrow><mtext>I</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>B</mtext></mrow></mrow></mrow></msub></mrow></mrow></mfrac></mrow></math>，答案以 r 表示。（2 分）</p><p><i><b> </b></i><i><b>(b) </b></i><b>如果</b><i><b>I</b></i><i><b><sub>A</sub></b></i><i><b> </b></i><b>增加了</b><i><b>3.5 A</b></i><b>，在</b><i><b>P</b></i><i><b> </b></i><b>點磁場的強</b><b>度便會變為</b><i><b>1.4 × 10</b></i><i><b><sup>–4</sup></b></i><i><b> T</b></i><i><b>。</b></i></p><p><i><b> </b></i><i><b> </b></i><i><b>(i) </b></i><b>證明</b><i><b>r</b></i><i><b> = 0.005 m</b></i><i><b>。</b></i><i><b> </b></i><i><b>（</b></i><i><b>2</b></i><b> 分）</b></p><p><i><b> </b></i><i><b> </b></i><i><b>(ii) </b></i><b>找出在</b><i><b>P</b></i><i><b> </b></i><b>點的磁場方向。</b><i><b> </b></i><i><b>（</b></i><i><b>1</b></i><b> 分）</b></p>","answer":"<p>(a) (i) 向上。</p><p>    (ii)  <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mrow><mfrac><mrow><mrow><msub><mrow><mrow><mrow><mtext>μ</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>0</mtext></mrow></mrow></mrow></msub><msub><mrow><mrow><mrow><mtext>I</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>A</mtext></mrow></mrow></mrow></msub></mrow></mrow><mrow><mrow><mrow><mtext>2π</mtext></mrow><msub><mrow><mrow><mrow><mtext>r</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>A</mtext></mrow></mrow></mrow></msub></mrow></mrow></mfrac></mrow></mrow></math>=<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mrow><mfrac><mrow><mrow><msub><mrow><mrow><mrow><mtext>μ</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>0</mtext></mrow></mrow></mrow></msub><msub><mrow><mrow><mrow><mtext>I</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>B</mtext></mrow></mrow></mrow></msub></mrow></mrow><mrow><mrow><mrow><mtext>2π</mtext></mrow><msub><mrow><mrow><mrow><mtext>r</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>B</mtext></mrow></mrow></mrow></msub></mrow></mrow></mfrac></mrow></mrow></math>  1M</p><p>      <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mrow><mfrac><mrow><mrow><msub><mrow><mrow><mrow><mtext>I</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>A</mtext></mrow></mrow></mrow></msub></mrow></mrow><mrow><mrow><msub><mrow><mrow><mrow><mtext>I</mtext></mrow></mrow></mrow><mrow><mrow><mrow><mtext>B</mtext></mrow></mrow></mrow></msub></mrow></mrow></mfrac></mrow></mrow></math>=<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mrow><mfrac><mrow><mrow><msub><mro